APP_NAME=HealthyHub
APP_ENV=production
NODE_ENV=production
APP_URL=https://healthyhub.example
WEB_PORT=3000
API_PORT=3001
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
CONTRACT_VERSION=v1

VITE_APP_NAME=HealthyHub
VITE_API_BASE_URL=https://api.healthyhub.example/api/v1

CORS_ORIGINS=https://healthyhub.example
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
LOG_LEVEL=info
LOG_REDACTION_KEYS=password,token,authorization,cookie,secret,apiKey

MYSQL_HOST=replace_with_mysql_host
MYSQL_PORT=3306
MYSQL_DATABASE=healthyhub
MYSQL_USER=healthyhub_user
MYSQL_PASSWORD=replace_with_secret_manager_value
MYSQL_ROOT_PASSWORD=replace_with_secret_manager_value
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

PHPMYADMIN_PORT=8080

AI_GATEWAY_PROVIDER=not_configured
AI_GATEWAY_API_KEY=replace_with_secret_manager_value
STORAGE_PROVIDER=not_configured
STORAGE_BUCKET=replace_with_bucket_name
STORAGE_ACCESS_KEY=replace_with_secret_manager_value
STORAGE_SECRET_KEY=replace_with_secret_manager_value
PAYMENT_PROVIDER=not_configured
PAYMENT_SECRET_KEY=replace_with_secret_manager_value
NOTIFICATION_PROVIDER=not_configured
MAIL_PROVIDER=not_configured
MAIL_FROM=no-reply@healthyhub.example
PAYMENT_PROVIDER=vnpay
VNPAY_TMN_CODE=
# Lấy terminal production đã được VNPAY phê duyệt và inject qua secret/config store.
VNPAY_HASH_SECRET=
# Lấy secret production tương ứng terminal từ VNPAY; inject qua Secret Manager, không commit.
VNPAY_PAYMENT_URL=
VNPAY_API_URL=
VNPAY_RETURN_URL=https://healthyhub.example/payment/vnpay/return
VNPAY_IPN_URL=https://api.healthyhub.example/api/v1/webhooks/payment/vnpay
# === XÁC THỰC / AUTHENTICATION (MÔI TRƯỜNG PRODUCTION) ===
# KHÔNG ghi secret trực tiếp vào file hoặc commit lên Git.
# Tạo từng secret độc lập bằng: openssl rand -base64 48
# Sau đó lưu/lấy qua Secret Manager (AWS Secrets Manager, GCP Secret Manager,
# Azure Key Vault, Docker/Kubernetes Secret hoặc secret store của nền tảng triển khai).
# Secret ký access JWT; cần kế hoạch rotation trước khi thay giá trị đang hoạt động.
AUTH_JWT_SECRET=replace_with_secret_manager_value
# Issuer/Audience phải cố định và khớp cấu hình của các client production.
AUTH_JWT_ISSUER=healthyhub-api
AUTH_JWT_AUDIENCE=healthyhub-clients
# TTL tính bằng giây: access/reset 15 phút, refresh 30 ngày, verification 24 giờ.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RESET_TOKEN_TTL_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Mỗi biến dùng một secret khác nhau; không tái sử dụng AUTH_JWT_SECRET.
AUTH_CSRF_SECRET=replace_with_secret_manager_value
AUTH_IDENTIFIER_HMAC_SECRET=replace_with_secret_manager_value
# Chỉ khai báo origin HTTPS thực tế, phân tách bằng dấu phẩy; không dùng dấu *.
AUTH_ALLOWED_ORIGINS=https://healthyhub.example
# Baseline Argon2id đã duyệt: 19456 KiB (19 MiB), time cost 2, parallelism 1.
AUTH_ARGON_MEMORY_COST_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1
