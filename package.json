{
  "name": "healthyhub",
  "version": "0.3.0",
  "private": true,
  "description": "HealthyHub full stack AI-ready monorepo foundation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @healthyhub/api",
    "dev:web": "npm run dev --workspace @healthyhub/web",
    "build": "npm run build:packages && npm run build:api && npm run build:web",
    "build:packages": "npm run build --workspace @healthyhub/shared-types && npm run build --workspace @healthyhub/shared-utils && npm run build --workspace @healthyhub/shared-config",
    "build:api": "npm run build --workspace @healthyhub/api",
    "build:web": "npm run build --workspace @healthyhub/web",
    "start:api": "npm run start:prod --workspace @healthyhub/api",
    "preview:web": "npm run preview --workspace @healthyhub/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @healthyhub/api",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "docker:up": "docker compose --env-file .env.development up -d --build",
    "docker:down": "docker compose --env-file .env.development down",
    "docker:check": "node --env-file=.env.development scripts/docker-startup-check.mjs",
    "audit:deps": "npm audit --registry=https://registry.npmjs.org --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
