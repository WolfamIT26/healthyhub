{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@healthyhub/shared-types": ["packages/shared-types/src/index.ts"],
      "@healthyhub/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@healthyhub/shared-config": ["packages/shared-config/src/index.ts"]
    }
  }
}
