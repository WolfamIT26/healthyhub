{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@healthyhub/shared-config": ["../../packages/shared-config/dist/index.d.ts"],
      "@healthyhub/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@healthyhub/shared-utils": ["../../packages/shared-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "tailwind.config.ts"]
}
