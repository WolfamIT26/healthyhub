{
  "name": "@healthyhub/web",
  "version": "0.1.0",
  "private": true,
  "description": "HealthyHub React web foundation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
