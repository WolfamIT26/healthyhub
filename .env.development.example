APP_NAME=HealthyHub
APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:3100
WEB_PORT=3100
API_PORT=3001
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
CONTRACT_VERSION=v1

VITE_APP_NAME=HealthyHub
VITE_API_BASE_URL=http://localhost:3001/api/v1

CORS_ORIGINS=http://localhost:3100
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=debug
LOG_REDACTION_KEYS=password,token,authorization,cookie,secret,apiKey

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=healthyhub_dev
MYSQL_USER=healthyhub_dev_user
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_dev_root_password
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

PHPMYADMIN_PORT=8080

# === XÁC THỰC / AUTHENTICATION (MÔI TRƯỜNG DEVELOPMENT) ===
# Chạy lệnh sau 3 lần để tạo 3 secret riêng: openssl rand -base64 48
# Sao chép file này thành file env cục bộ rồi thay placeholder; tuyệt đối không commit secret thật.
# Secret ký access JWT; tối thiểu 32 ký tự ngẫu nhiên.
AUTH_JWT_SECRET=change_me_dev_auth_jwt_secret_at_least_32_chars
# Issuer/Audience nhận diện API phát token và nhóm client được phép sử dụng token.
AUTH_JWT_ISSUER=healthyhub-api
AUTH_JWT_AUDIENCE=healthyhub-clients
# TTL tính bằng giây: 900=15 phút, 2592000=30 ngày, 86400=24 giờ.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RESET_TOKEN_TTL_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Hai secret này phải khác nhau và khác AUTH_JWT_SECRET.
AUTH_CSRF_SECRET=change_me_dev_csrf_secret_at_least_32_chars
AUTH_IDENTIFIER_HMAC_SECRET=change_me_dev_identifier_hmac_at_least_32_chars
# Origin frontend development; thêm origin khác bằng dấu phẩy, không dùng wildcard khi có cookie.
AUTH_ALLOWED_ORIGINS=http://localhost:3100
# Argon2id: memory cost dùng KiB (19456 KiB = 19 MiB); giữ baseline đã phê duyệt.
AUTH_ARGON_MEMORY_COST_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1

AI_GATEWAY_PROVIDER=not_configured
AI_GATEWAY_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=not_configured
PAYMENT_SECRET_KEY=
VNPAY_TMN_CODE=
# Lấy mã website/terminal trong tài khoản VNPAY Sandbox Merchant Admin.
VNPAY_HASH_SECRET=
# Lấy chuỗi bí mật cùng terminal trong VNPAY Sandbox Merchant Admin; giữ ngoài Git.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3100/payment/vnpay/return
# Localhost không nhận được IPN server-to-server; dùng HTTPS tunnel/public callback khi chạy Sandbox E2E.
VNPAY_IPN_URL=https://replace-with-public-sandbox-callback.example/api/v1/webhooks/payment/vnpay
NOTIFICATION_PROVIDER=not_configured
MAIL_PROVIDER=not_configured
MAIL_FROM=no-reply@healthyhub.local
