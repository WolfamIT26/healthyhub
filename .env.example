# Application / Ứng dụng
APP_NAME=HealthyHub
APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
CONTRACT_VERSION=v1

# Web / Frontend
VITE_APP_NAME=HealthyHub
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Security / Bảo mật nền
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info
LOG_REDACTION_KEYS=password,token,authorization,cookie,secret,apiKey

# Database / MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=healthyhub
MYSQL_USER=healthyhub_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# phpMyAdmin
PHPMYADMIN_PORT=8080

# Auth module reserved / Dành cho module Authentication sau này, chưa dùng ở foundation
JWT_SECRET=change_me_when_auth_module_is_implemented
JWT_EXPIRES_IN=1d

# Gateway placeholders / Cấu hình gateway chưa tích hợp provider thật
AI_GATEWAY_PROVIDER=not_configured
AI_GATEWAY_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=not_configured
PAYMENT_SECRET_KEY=
NOTIFICATION_PROVIDER=not_configured
MAIL_PROVIDER=not_configured
MAIL_FROM=no-reply@healthyhub.local
