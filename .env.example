# Application / Ứng dụng
APP_NAME=HealthyHub
APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
CONTRACT_VERSION=v1

# Web / Frontend
VITE_APP_NAME=HealthyHub
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Security / Bảo mật nền
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info
LOG_REDACTION_KEYS=password,token,authorization,cookie,secret,apiKey

# Database / MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=healthyhub
MYSQL_USER=healthyhub_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# phpMyAdmin
PHPMYADMIN_PORT=8080

# Gateway placeholders / Cấu hình gateway chưa tích hợp provider thật
AI_GATEWAY_PROVIDER=not_configured
AI_GATEWAY_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=not_configured
PAYMENT_SECRET_KEY=
NOTIFICATION_PROVIDER=not_configured
MAIL_PROVIDER=not_configured
MAIL_FROM=no-reply@healthyhub.local
# === XÁC THỰC / AUTHENTICATION ===
# Tạo 3 secret KHÁC NHAU bằng lệnh: openssl rand -base64 48
# Không commit giá trị thật. Production phải lấy secret từ Secret Manager của nền tảng triển khai.
# Secret ký access JWT; tối thiểu 32 ký tự ngẫu nhiên.
AUTH_JWT_SECRET=change_me_auth_jwt_secret_at_least_32_chars
# Issuer/Audience dùng để từ chối JWT được phát cho hệ thống hoặc client khác.
AUTH_JWT_ISSUER=healthyhub-api
AUTH_JWT_AUDIENCE=healthyhub-clients
# Thời hạn token tính bằng giây: access 15 phút, refresh 30 ngày,
# reset mật khẩu 15 phút và xác minh email 24 giờ.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RESET_TOKEN_TTL_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Secret ký CSRF và secret HMAC identifier phải khác AUTH_JWT_SECRET và khác nhau.
AUTH_CSRF_SECRET=change_me_csrf_secret_at_least_32_chars
AUTH_IDENTIFIER_HMAC_SECRET=change_me_identifier_hmac_at_least_32_chars
# Danh sách origin được phép, phân tách bằng dấu phẩy; ghi chính xác scheme + host + port.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Tham số Argon2id đã được phê duyệt: 19 MiB, 2 vòng, parallelism 1; không tự ý giảm.
AUTH_ARGON_MEMORY_COST_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1
