APP_NAME=HealthyHub
APP_ENV=test
NODE_ENV=test
APP_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
CONTRACT_VERSION=v1

VITE_APP_NAME=HealthyHub
VITE_API_BASE_URL=http://localhost:3001/api/v1

CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=200
LOG_LEVEL=warn
LOG_REDACTION_KEYS=password,token,authorization,cookie,secret,apiKey

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=healthyhub_test
MYSQL_USER=healthyhub_test_user
MYSQL_PASSWORD=change_me_test_password
MYSQL_ROOT_PASSWORD=change_me_test_root_password
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

PHPMYADMIN_PORT=8081

AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
NOTIFICATION_PROVIDER=mock
MAIL_PROVIDER=mock
MAIL_FROM=test@healthyhub.local
# === XÁC THỰC / AUTHENTICATION (MÔI TRƯỜNG TEST) ===
# Có thể tạo secret test bằng lệnh: openssl rand -base64 48 (chạy 3 lần, mỗi biến một secret).
# Chỉ dùng cho test; không tái sử dụng secret development hoặc production.
AUTH_JWT_SECRET=replace_with_test_auth_jwt_secret_at_least_32_chars
# Issuer/Audience riêng giúp token test không dùng nhầm ở môi trường khác.
AUTH_JWT_ISSUER=healthyhub-api-test
AUTH_JWT_AUDIENCE=healthyhub-test-clients
# TTL tính bằng giây: access/reset 15 phút, refresh 30 ngày, verification 24 giờ.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RESET_TOKEN_TTL_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
# CSRF signing và identifier HMAC phải sử dụng hai secret độc lập.
AUTH_CSRF_SECRET=replace_with_test_csrf_secret_at_least_32_chars
AUTH_IDENTIFIER_HMAC_SECRET=replace_with_test_identifier_hmac_at_least_32_chars
# Origin chính xác của test client; nhiều origin phân tách bằng dấu phẩy.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Baseline Argon2id production-like để kiểm thử đúng thuật toán và định dạng hash.
AUTH_ARGON_MEMORY_COST_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1
